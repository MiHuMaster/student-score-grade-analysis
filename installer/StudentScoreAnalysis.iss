#define AppName "student-score-analysis"
#define AppVersion "1.0.0"
#define AppExe "StudentScoreAnalysis.exe"

[Setup]
AppId={{8E8B26B5-AC06-44A1-91BC-DBB748A02F9D}
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisher={#AppName}
DefaultDirName={localappdata}\Programs\student-score-analysis
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
OutputDir=..\dist\installer
OutputBaseFilename=student-score-analysis_Setup_{#AppVersion}
SetupIconFile=..\release\app.ico
UninstallDisplayIcon={app}\{#AppExe}
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
AppMutex=Global\StudentScoreAnalysis.Running
CloseApplications=no
RestartApplications=no
; No LocalAppData entries and no UninstallDelete section: user data survives.

[Languages]
Name: "chinesesimplified"; MessagesFile: "ChineseSimplified.isl"

[Messages]
SetupAppRunningError=检测到“%1”仍在运行。%n%n请先回到student-score-analysis左下角点击“完全退出程序”，然后点击“确定”继续，或点击“取消”退出安装。
UninstallAppRunningError=检测到“%1”仍在运行。%n%n请先回到student-score-analysis左下角点击“完全退出程序”，然后点击“确定”继续，或点击“取消”退出卸载。

[Tasks]
Name: "desktopicon"; Description: "创建桌面快捷方式"; GroupDescription: "快捷方式："

[Files]
; Generated by the scanner: explicit files and hashes, never a recursive wildcard.
#include "release-files.iss"

[Icons]
Name: "{autoprograms}\{#AppName}\{#AppName}"; Filename: "{app}\{#AppExe}"; WorkingDir: "{app}"; IconFilename: "{app}\{#AppExe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExe}"; WorkingDir: "{app}"; IconFilename: "{app}\{#AppExe}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#AppExe}"; Description: "启动{#AppName}"; Flags: nowait postinstall skipifsilent runasoriginaluser
